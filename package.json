{
  "name": "automation-perpusqa",
  "version": "1.0.0",
  "description": "Playwright Test Automation for PerpusQA",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:smoke": "playwright test --grep @smoke",
    "test:rbac": "playwright test tests/api/rbac.spec.ts --project=api",
    "test:boundary": "playwright test tests/api/boundary*.spec.ts --project=api",
    "test:e2e": "playwright test --project=chromium",
    "test:regression": "playwright test --grep @regression",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report"
  },
  "keywords": [
    "playwright",
    "test-automation",
    "perpusqa",
    "api-testing",
    "e2e"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.8"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
